# Copy to .env.local and fill in. Never commit real values.

# Claude API (Phase 2 agent)
ANTHROPIC_API_KEY=
# Model for the chat and uputnica reading (Haiku passed all 15 eval scenarios)
ANTHROPIC_MODEL=claude-haiku-5-5

# Supabase (EU / Frankfurt project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (doctor + patient emails); demo emails go only to team inboxes
RESEND_API_KEY=
EMAIL_FROM="Uputko <onboarding@resend.dev>"
# Every demo email (to "doctors" and to the synthetic patients) goes ONLY here.
# Real doctors from the HZZO data are never emailed.
DEMO_INBOX=uputko.demo@gmail.com

# Public base URL, used in email links
NEXT_PUBLIC_APP_URL=http://localhost:3000
